<svg width="512" height="512" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1e3a8a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1e40af;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Rounded rectangle background -->
  <rect width="512" height="512" rx="102" ry="102" fill="url(#grad)" />
  
  <!-- Invoice document icon -->
  <rect x="140" y="120" width="232" height="280" rx="16" ry="16" fill="#fff" opacity="0.95" />
  
  <!-- Invoice lines -->
  <line x1="180" y1="180" x2="340" y2="180" stroke="#1e3a8a" stroke-width="4" stroke-linecap="round" />
  <line x1="180" y1="210" x2="320" y2="210" stroke="#1e3a8a" stroke-width="4" stroke-linecap="round" />
  <line x1="180" y1="240" x2="290" y2="240" stroke="#1e3a8a" stroke-width="4" stroke-linecap="round" />
  <line x1="180" y1="300" x2="340" y2="300" stroke="#1e3a8a" stroke-width="3" stroke-linecap="round" />
  <line x1="180" y1="325" x2="280" y2="325" stroke="#1e3a8a" stroke-width="3" stroke-linecap="round" />
  
  <!-- Total amount box -->
  <rect x="180" y="350" width="160" height="30" rx="4" ry="4" fill="#1e40af" />
  
  <!-- Company initials -->
  <text x="256" y="450" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#fff" text-anchor="middle">NE</text>
</svg>
