# Supabase Configuration for Vercel Deployment
# Copy this file to .env.local and replace with your actual credentials

# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service Role Key (for server-side operations)
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Development Notes:
# 1. Copy this file to .env.local
# 2. Replace 'your-project-id' with your actual Supabase project ID
# 3. Replace 'your-anon-key-here' with your actual anon key
# 4. This file is automatically used by Next.js
# 5. For Vercel, also add these as Environment Variables in Vercel dashboard
